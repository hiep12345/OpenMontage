{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/knowledge_application",
  "title": "Knowledge Application",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "applied",
              "rejected",
              "inapplicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "output_evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "decision",
          "reason",
          "output_evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "stage",
    "context_hash",
    "id",
    "created_at",
    "artifact_hash",
    "reviewer",
    "decisions"
  ],
  "additionalProperties": false
}
